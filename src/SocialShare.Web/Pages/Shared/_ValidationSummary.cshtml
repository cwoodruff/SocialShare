@model Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary
@if (!Model.IsValid)
{
    <div class="validation-summary" role="alert">
        <ul>
            @foreach (var error in Model.SelectMany(entry => entry.Value!.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
