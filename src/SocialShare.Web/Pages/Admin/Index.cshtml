@page "/admin"
@model SocialShare.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}

<div class="stack">
    <div class="card__header">
        <div>
            <h1>Admin</h1>
            <p class="muted small" style="margin:0;">
                @Model.Rows.Count user@(Model.Rows.Count == 1 ? "" : "s") across @Model.TotalOrganizations
                organization@(Model.TotalOrganizations == 1 ? "" : "s"). Read only.
            </p>
        </div>
    </div>

    <partial name="_EmailCheck" model="Model" />

    <div class="card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Organization</th>
                        <th scope="col">Plan</th>
                        <th scope="col">Connected</th>
                        <th scope="col">Posts</th>
                        <th scope="col">Scheduled</th>
                        <th scope="col">Joined</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <strong>@row.DisplayName</strong>
                                <div class="tiny muted">@row.Email</div>
                                <div class="tiny faint">@row.TimeZoneId</div>
                            </td>
                            <td>@row.OrganizationName</td>
                            <td><span class="badge badge--accent">@row.Plan</span></td>
                            <td>@row.ConnectedAccounts</td>
                            <td>@row.Posts</td>
                            <td>@row.ScheduledPosts</td>
                            <td class="nowrap">@row.CreatedUtc.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="small muted">
        Admin is granted by listing an email under <code>App:AdminEmails</code> in configuration.
        The role is applied on the next start.
    </p>
</div>
