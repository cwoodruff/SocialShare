@page "/register"
@model SocialShare.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth card stack">
    <h1>Create account</h1>

    @if (!Model.RegistrationEnabled)
    {
        <p class="notice notice--info">
            Registration is closed on this instance. Ask whoever runs it for an account.
        </p>
    }
    else
    {
        <partial name="_ValidationSummary" model="ModelState" />

        <form method="post" class="stack-sm">
            <div class="field">
                <label for="DisplayName">Your name</label>
                <input id="DisplayName" name="Input.DisplayName" value="@Model.Input.DisplayName" autocomplete="name" required />
            </div>

            <div class="field">
                <label for="Email">Email</label>
                <input id="Email" name="Input.Email" type="email" value="@Model.Input.Email" autocomplete="email" required />
            </div>

            <div class="field">
                <label for="Password">Password</label>
                <input id="Password" name="Input.Password" type="password" autocomplete="new-password" required minlength="10" />
                <span class="field__help">At least 10 characters, with an upper case letter, a lower case letter and a digit.</span>
            </div>

            <div class="field">
                <label for="ConfirmPassword">Confirm password</label>
                <input id="ConfirmPassword" name="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>

            <div class="field">
                <label for="TimeZoneId">Time zone</label>
                <select id="TimeZoneId" name="Input.TimeZoneId">
                    @foreach (var zone in AppTimeZone.CommonZones)
                    {
                        <option value="@zone" selected="@(zone == Model.Input.TimeZoneId)">@zone</option>
                    }
                </select>
                <span class="field__help">Scheduling uses this. You can change it later in settings.</span>
            </div>

            <button type="submit" class="btn btn--primary btn--block">Create account</button>
        </form>

        <p class="small muted">Already have one? <a href="/login">Sign in</a>.</p>
    }
</div>
