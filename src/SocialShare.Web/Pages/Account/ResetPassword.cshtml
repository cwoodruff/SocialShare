@page "/reset-password"
@model SocialShare.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
}

<div class="auth card stack">
    <h1>Set a new password</h1>

    <partial name="_ValidationSummary" model="ModelState" />

    <form method="post" class="stack-sm">
        <input type="hidden" name="Input.Code" value="@Model.Input.Code" />

        <div class="field">
            <label for="Email">Email</label>
            <input id="Email" name="Input.Email" type="email" value="@Model.Input.Email" autocomplete="username" required />
        </div>

        <div class="field">
            <label for="Password">New password</label>
            <input id="Password" name="Input.Password" type="password" autocomplete="new-password" required minlength="10" />
        </div>

        <div class="field">
            <label for="ConfirmPassword">Confirm new password</label>
            <input id="ConfirmPassword" name="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>

        <button type="submit" class="btn btn--primary btn--block">Set password</button>
    </form>
</div>
