@page "/forgot-password"
@model SocialShare.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="auth card stack">
    <h1>Reset your password</h1>

    @if (Model.Sent)
    {
        <p class="notice notice--success">
            If that email belongs to an account, a reset link is on its way. In development the
            link is written to the server log instead of being emailed.
        </p>
        <p class="small"><a href="/login">Back to sign in</a></p>
    }
    else
    {
        <partial name="_ValidationSummary" model="ModelState" />
        <p class="muted small">Enter the email you signed up with and I will send a reset link.</p>

        <form method="post" class="stack-sm">
            <div class="field">
                <label for="Email">Email</label>
                <input id="Email" name="Email" type="email" value="@Model.Email" autocomplete="email" required />
            </div>
            <button type="submit" class="btn btn--primary btn--block">Send reset link</button>
        </form>
    }
</div>
