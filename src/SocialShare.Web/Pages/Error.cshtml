@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="card measure">
    <h1>Something went wrong</h1>
    <p class="muted">
        That request did not finish. If it keeps happening, the server log has the detail.
    </p>
    @if (Model.RequestId is not null)
    {
        <p class="small muted">Request id: <code>@Model.RequestId</code></p>
    }
    <p><a class="btn" href="/">Back to the home page</a></p>
</div>
